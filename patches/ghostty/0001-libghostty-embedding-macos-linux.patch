+pub fn displayForDrmNode(path: [:0]const u8) !*egl.Display {
+    try egl.load();
+    const query_devices: QueryDevicesFn = @ptrCast(egl.c.eglGetProcAddress("eglQueryDevicesEXT") orelse
+        return error.Unsupported);
+    const query_string: QueryDeviceStringFn = @ptrCast(egl.c.eglGetProcAddress("eglQueryDeviceStringEXT") orelse
+        return error.Unsupported);
+
+    const want = rdevOf(path.ptr) orelse return error.DeviceNotFound;
+
+    var devices: [16]?*anyopaque = @splat(null);
+    var count: egl.c.EGLint = 0;
+    if (query_devices(devices.len, &devices, &count) != egl.c.EGL_TRUE) return error.Unsupported;
+
+    for (devices[0..@intCast(count)]) |dev| {
+        for ([_]egl.c.EGLint{ EGL_DRM_RENDER_NODE_FILE_EXT, EGL_DRM_DEVICE_FILE_EXT }) |which| {
+            const node = query_string(dev, which) orelse continue;
+            const got = rdevOf(node) orelse continue;
+            if (got[0] != want[0] or got[1] != want[1]) continue;
+            log.info("rendering on EGL device {s} (requested {s})", .{ node, path });
+            return egl.Display.initPlatform(EGL_PLATFORM_DEVICE_EXT, @ptrCast(dev), null);
+        }
+    }
+    log.warn("no EGL device matches {s}; using the default device", .{path});
+    return error.DeviceNotFound;
+}
+
+/// Device number (major, minor) of a device node.
+fn rdevOf(path: [*:0]const u8) ?[2]u32 {
+    const linux = std.os.linux;
+    var sx: linux.Statx = undefined;
+    const rc = linux.statx(linux.AT.FDCWD, path, 0, .{ .TYPE = true }, &sx);
+    if (linux.errno(rc) != .SUCCESS) return null;
+    return .{ sx.rdev_major, sx.rdev_minor };
+}
