+    ctx.GetIntegerv.?(c.GL_VERTEX_ARRAY_BINDING, &prev_vao);
+    ctx.GetIntegerv.?(c.GL_DRAW_FRAMEBUFFER_BINDING, &prev_fbo);
+    ctx.GetIntegerv.?(c.GL_ACTIVE_TEXTURE, &prev_active);
+    ctx.ActiveTexture.?(c.GL_TEXTURE0);
+    ctx.GetIntegerv.?(c.GL_TEXTURE_BINDING_2D, &prev_tex);
