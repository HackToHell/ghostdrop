+//! ghostdrop: allocate export buffers with GBM in a layout the presenting
+//! side (X server via DRI3, or a Wayland compositor) can import.
+//!
+//! A plain GL texture gets whatever layout the driver likes best; NVIDIA,
+//! for one, picks compressed block-linear kinds that its X server refuses to
+//! import. GBM lets us pick from the consumer's modifier list instead. libgbm
+//! is loaded at runtime so it stays an optional dependency.
+const std = @import("std");
+
+const log = std.log.scoped(.opengl_gbm);
+
+/// DRM_FORMAT_ARGB8888 ('AR24').
+pub const format_argb8888: u32 = 0x34325241;
+
+/// Set by the embedder before surfaces exist (see embedded.zig).
+pub var render_node: [256:0]u8 = @splat(0);
+pub var modifiers: [64]u64 = undefined;
+pub var modifier_count: usize = 0;
+
+const Device = opaque {};
+pub const Bo = opaque {};
+
+const Api = struct {
+    create_device: *const fn (c_int) callconv(.c) ?*Device,
+    bo_create_with_modifiers: *const fn (?*Device, u32, u32, u32, [*]const u64, c_uint) callconv(.c) ?*Bo,
+    bo_destroy: *const fn (*Bo) callconv(.c) void,
+    bo_get_plane_count: *const fn (*Bo) callconv(.c) c_int,
+    bo_get_fd_for_plane: *const fn (*Bo, c_int) callconv(.c) c_int,
+    bo_get_stride_for_plane: *const fn (*Bo, c_int) callconv(.c) u32,
+    bo_get_offset: *const fn (*Bo, c_int) callconv(.c) u32,
+    bo_get_modifier: *const fn (*Bo) callconv(.c) u64,
+};
+
+var api: Api = undefined;
+var device: ?*Device = null;
+/// 0 = not tried, 1 = in progress, 2 = ready, 3 = unavailable.
+var state: std.atomic.Value(u8) = .init(0);
+
+/// The GBM device on `render_node`, or null if GBM isn't usable/configured.
+fn getDevice() ?*Device {
+    while (true) {
+        switch (state.load(.acquire)) {
+            2 => return device,
+            3 => return null,
+            1 => std.Thread.yield() catch {},
+            else => if (state.cmpxchgStrong(0, 1, .acq_rel, .acquire) == null) {
+                const ok = init();
+                state.store(if (ok) 2 else 3, .release);
+                return if (ok) device else null;
+            },
+        }
+    }
+}
+
+fn init() bool {
+    const len = std.mem.indexOfScalar(u8, &render_node, 0) orelse 0;
+    if (len == 0 or modifier_count == 0) return false;
+    const lib = std.c.dlopen("libgbm.so.1", .{ .NOW = true }) orelse {
+        log.warn("libgbm.so.1 not found; export buffers use the driver's layout", .{});
+        return false;
+    };
+    inline for (@typeInfo(Api).@"struct".field_names) |name| {
+        const sym = std.c.dlsym(lib, "gbm_" ++ name) orelse {
+            log.warn("libgbm lacks gbm_{s}", .{name});
+            return false;
+        };
+        @field(api, name) = @ptrCast(@alignCast(sym));
+    }
+    const fd = std.c.open(render_node[0..len :0], .{ .ACCMODE = .RDWR, .CLOEXEC = true });
+    if (fd < 0) {
+        log.warn("cannot open {s} for GBM", .{render_node[0..len]});
+        return false;
+    }
+    device = api.create_device(fd) orelse {
+        log.warn("gbm_create_device failed on {s}", .{render_node[0..len]});
+        _ = std.c.close(fd);
+        return false;
+    };
+    log.info("GBM export buffers on {s} ({} modifiers)", .{ render_node[0..len], modifier_count });
+    return true;
+}
+
+pub const Plane = struct { fd: c_int, stride: u32, offset: u32 };
+
+/// An ARGB8888 buffer with one of the configured modifiers.
+pub const Buffer = struct {
+    bo: *Bo,
+    modifier: u64,
+    planes: [4]Plane,
+    plane_count: usize,
+
+    /// Allocate; null if GBM is unavailable or allocation fails.
+    pub fn create(width: u32, height: u32) ?Buffer {
+        const dev = getDevice() orelse return null;
+        // GBM_BO_USE_RENDERING; modifiers come from the consumer.
+        const bo = api.bo_create_with_modifiers(dev, width, height, format_argb8888, &modifiers, @intCast(modifier_count)) orelse {
+            log.warn("gbm_bo_create_with_modifiers {}x{} failed", .{ width, height });
+            return null;
+        };
+        const n: usize = @intCast(@max(1, @min(4, api.bo_get_plane_count(bo))));
+        var b: Buffer = .{ .bo = bo, .modifier = api.bo_get_modifier(bo), .planes = undefined, .plane_count = n };
+        for (0..n) |i| {
+            const fd = api.bo_get_fd_for_plane(bo, @intCast(i));
+            if (fd < 0) {
+                for (b.planes[0..i]) |p| _ = std.c.close(p.fd);
+                api.bo_destroy(bo);
+                return null;
+            }
+            b.planes[i] = .{
+                .fd = fd,
+                .stride = api.bo_get_stride_for_plane(bo, @intCast(i)),
+                .offset = api.bo_get_offset(bo, @intCast(i)),
+            };
+        }
+        return b;
+    }
+
+    pub fn destroy(self: *Buffer) void {
+        for (self.planes[0..self.plane_count]) |p| _ = std.c.close(p.fd);
+        api.bo_destroy(self.bo);
+    }
+};
