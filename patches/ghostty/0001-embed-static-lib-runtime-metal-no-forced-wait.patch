+    /// Take the most recently rendered frame of a surface, if any (Linux).
+    /// Returns false if no new frame is available. The caller owns the
+    /// frame and must release it with ghostty_frame_free.
+    export fn ghostty_surface_take_frame(surface: *Surface, out: *FrameC) bool {
+        const ExportedFrame = renderer.Renderer.ExportedFrame;
+        if (comptime ExportedFrame == void) return false;
+
+        const frame = surface.core_surface.renderer.takeFrame() orelse return false;
+        const box = std.heap.c_allocator.create(ExportedFrame) catch {
+            frame.deinit();
+            return false;
+        };
+        box.* = frame;
+
+        var c: FrameC = .{ .handle = box, .flip_y = !renderer.Renderer.custom_shader_y_is_down };
+        switch (frame) {
+            .memory => |m| {
+                c.kind = 0;
+                c.width = m.width;
+                c.height = m.height;
+                c.pixels = m.pixels.ptr;
+                c.stride = @as(usize, m.width) * 4;
+                c.premultiplied = true;
+            },
+            .dmabuf => |d| {
+                c.kind = 1;
+                c.width = d.width;
+                c.height = d.height;
+                c.fourcc = d.fourcc;
+                c.modifier = d.modifier;
+                c.premultiplied = d.premultiplied;
+                c.n_planes = d.planes.count;
+                for (0..d.planes.count) |i| {
+                    c.fds[i] = d.planes.fds[i];
+                    c.offsets[i] = @intCast(d.planes.offsets[i]);
+                    c.strides[i] = @intCast(d.planes.strides[i]);
+                }
+            },
+        }
+        out.* = c;
+        return true;
+    }
+
+    /// Release a frame returned by ghostty_surface_take_frame. For DMA-BUF
+    /// frames this closes the file descriptors.
+    export fn ghostty_frame_free(handle: ?*anyopaque) void {
+        const ExportedFrame = renderer.Renderer.ExportedFrame;
+        if (comptime ExportedFrame == void) return;
+        const box: *ExportedFrame = @ptrCast(@alignCast(handle orelse return));
+        box.deinit();
+        std.heap.c_allocator.destroy(box);
+    }
+
+    /// Tell the renderer whether the embedder can present GPU (DMA-BUF)
+    /// frames. When false, the renderer hands out CPU frames instead.
+    export fn ghostty_surface_set_gpu_frames(surface: *Surface, enabled: bool) void {
+        surface.core_surface.reportPresentationHealth(if (enabled) .healthy else .unhealthy);
+    }
