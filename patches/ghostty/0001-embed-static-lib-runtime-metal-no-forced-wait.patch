 /// Initialize the MTLLibrary. A MTLLibrary is a collection of shaders.
+/// The embedded shader blob. This is either a precompiled metallib
+/// (magic "MTLB") or, when built with -Dmetal-runtime-compile, the
+/// Metal shader source which we compile once per process at runtime.
+const embedded_shaders = @embedFile("ghostty_metallib");
+const embedded_is_metallib = std.mem.startsWith(u8, embedded_shaders, "MTLB");
+
+/// Process-wide cache for the runtime-compiled library so that only the
+/// first surface pays the compile cost. Keyed by device.
+var runtime_lib_mutex: std.atomic.Mutex = .unlocked;
+var runtime_lib_device: usize = 0;
+var runtime_lib: ?objc.Object = null;
+
 fn initLibrary(device: objc.Object) !objc.Object {
+    if (comptime !embedded_is_metallib) return try initLibraryFromSource(device);
+    return try initLibraryFromMetallib(device);
+}
+
+fn initLibraryFromSource(device: objc.Object) !objc.Object {
+    while (!runtime_lib_mutex.tryLock()) std.atomic.spinLoopHint();
+    defer runtime_lib_mutex.unlock();
+
+    if (runtime_lib) |lib| {
+        if (runtime_lib_device == @intFromPtr(device.value)) {
+            // Caller owns a reference (it releases on deinit).
+            return lib.msgSend(objc.Object, objc.sel("retain"), .{});
+        }
+    }
+
+    const start: std.Io.Timestamp = .now(global.io(), .awake);
+    const source = try macos.foundation.String.createWithBytes(
+        embedded_shaders,
+        .utf8,
+        false,
+    );
+    defer source.release();
+
+    var err: ?*anyopaque = null;
+    const library = device.msgSend(
+        objc.Object,
+        objc.sel("newLibraryWithSource:options:error:"),
+        .{ source, @as(?*anyopaque, null), &err },
+    );
+    try checkError(err);
+
+    log.debug("shader library compiled from source time={}us", .{start.untilNow(global.io(), .awake).toMicroseconds()});
+
+    if (runtime_lib) |old| old.msgSend(void, objc.sel("release"), .{});
+    runtime_lib = library.msgSend(objc.Object, objc.sel("retain"), .{});
+    runtime_lib_device = @intFromPtr(device.value);
+    return library;
+}
+
+fn initLibraryFromMetallib(device: objc.Object) !objc.Object {
     const start: std.Io.Timestamp = .now(global.io(), .awake);
 
     const data = try macos.dispatch.Data.create(
-        @embedFile("ghostty_metallib"),
+        embedded_shaders,
         macos.dispatch.queue.getMain(),
         macos.dispatch.Data.DESTRUCTOR_DEFAULT,
     );
